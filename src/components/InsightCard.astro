---
import { formatDate, isoDate, readingTime, urlFor, type Insight } from '../lib/insights';

interface Props {
  post: Insight;
}

const { post } = Astro.props;
---

<a
  href={urlFor(post)}
  class="group flex flex-col bg-white border border-slate-200 rounded-sm p-7 hover:border-amber-500/50 hover:shadow-[0_2px_24px_rgba(15,23,42,0.06)] transition-all duration-300"
>
  <div class="flex flex-wrap items-center gap-x-2 gap-y-1 font-sans text-[10px] uppercase tracking-widest">
    <span class="text-amber-600 font-semibold">{post.data.category}</span>
    <span class="text-slate-300" aria-hidden="true">/</span>
    <time datetime={isoDate(post.data.datePublished)} class="text-slate-500">
      {formatDate(post.data.datePublished)}
    </time>
  </div>

  <h2 class="mt-4 text-xl font-serif-legal font-bold text-slate-900 leading-snug group-hover:text-amber-700 transition-colors duration-300">
    {post.data.title}
  </h2>

  <p class="mt-3 text-sm text-slate-600 leading-relaxed font-sans flex-grow">
    {post.data.excerpt ?? post.data.description}
  </p>

  <span class="mt-5 pt-4 border-t border-slate-100 text-[11px] font-sans uppercase tracking-widest text-slate-500">
    {readingTime(post)} read
  </span>
</a>
